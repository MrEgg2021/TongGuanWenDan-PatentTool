{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: gui_app.py (GUI)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}\\gui_app.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONUTF8": "1",
                "PYTHONIOENCODING": "utf-8"
            },
            "justMyCode": true
        },
        {
            "name": "Python: Current File (Integrated Terminal)",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONUTF8": "1",
                "PYTHONIOENCODING": "utf-8"
            },
            "justMyCode": true
        }
    ]
}
