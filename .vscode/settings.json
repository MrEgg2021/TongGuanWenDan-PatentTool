{
    "chatgpt.openOnStartup": true,
    "files.encoding": "utf8",
    "files.autoGuessEncoding": false,
    "terminal.integrated.defaultProfile.windows": "PowerShell UTF-8",
    "terminal.integrated.profiles.windows": {
        "PowerShell UTF-8": {
            "source": "PowerShell",
            "args": [
                "-NoLogo",
                "-NoProfile",
                "-NoExit",
                "-Command",
                "chcp 65001 > $null; [Console]::InputEncoding = [System.Text.UTF8Encoding]::new($false); [Console]::OutputEncoding = [System.Text.UTF8Encoding]::new($false); $OutputEncoding = [Console]::OutputEncoding"
            ]
        }
    },
    "terminal.integrated.env.windows": {
        "PYTHONUTF8": "1",
        "PYTHONIOENCODING": "utf-8"
    },
    "python.defaultInterpreterPath": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
    "python.terminal.activateEnvironment": true,
    "python.terminal.executeInFileDir": false,
    "python.analysis.extraPaths": [
        "${workspaceFolder}"
    ]
}
